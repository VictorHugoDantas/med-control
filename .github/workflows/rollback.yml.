name: Rollback Manual

on:
  workflow_dispatch:
    inputs:
      versao:
        description: "Versão para voltar (ex: 1.0.0)"
        required: true
        type: string

env:
  REGISTRY: ghcr.io

jobs:
  rollback:
    runs-on: ubuntu-latest
    environment: producao
    permissions:
      contents: read
      packages: write

    steps:
    - uses: actions/checkout@v4

    - name: Definir imagem
      run: echo "IMAGE=${REGISTRY}/${GITHUB_REPOSITORY,,}" >> "$GITHUB_ENV"

    - name: Login no GHCR
      uses: docker/login-action@v3
      with:
        registry: ${{ env.REGISTRY }}
        username: ${{ github.actor }}
        password: ${{ secrets.GITHUB_TOKEN }}

    - name: Verificar se a versão existe
      run: |
        docker buildx imagetools inspect "$IMAGE:${{ inputs.versao }}" > /dev/null \
          || { echo "Versão ${{ inputs.versao }} não encontrada no registry"; exit 1; }

    - name: Apontar produção para a versão escolhida
      run: |
        docker buildx imagetools create -t "$IMAGE:producao" "$IMAGE:${{ inputs.versao }}"

    - name: Smoke test
      env:
        SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
        SUPABASE_ANON_KEY: ${{ secrets.SUPABASE_ANON_KEY }}
      run: |
        docker pull "$IMAGE:producao"
        bash scripts/smoke_test.sh "$IMAGE:producao"

    - name: Resumo
      run: |
        echo "### Rollback manual" >> "$GITHUB_STEP_SUMMARY"
        echo "Produção agora está na versão ${{ inputs.versao }} (executado por ${{ github.actor }})" >> "$GITHUB_STEP_SUMMARY"
